# Seals the session cookie (min 32 chars). `nuxt dev` writes a random one to .env when missing.
NUXT_SESSION_PASSWORD=
# Service base URLs (defaults are the Tilt port-forwards).
NUXT_IDENTITY_URL=http://localhost:8101
NUXT_CATALOG_URL=http://localhost:8102
NUXT_PRICING_URL=http://localhost:8104
NUXT_INVENTORY_URL=http://localhost:8103
NUXT_ORDERS_URL=http://localhost:8108
# Where "View in store" links point.
NUXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
