{
  "name": "shopwise-admin",
  "private": true,
  "type": "module",
  "description": "Shopwise admin: Nuxt back office plus its Nitro BFF, for catalog and pricing staff (admin role only).",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "nuxt dev --port 3001",
    "build": "nuxt build",
    "preview": "nuxt preview --port 3001",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "prettier --check . && eslint . && nuxt typecheck && vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/ui": "^4.12.0",
    "h3": "^1.15.11",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "ofetch": "^1.5.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@shopwise/contracts": "github:MuriloSergioDev/shopwise-contracts",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "version": "1.1.0"
}
